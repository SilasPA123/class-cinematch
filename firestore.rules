rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One film: a map with only known fields, and a text id and title.
    // Kept deliberately short: Firestore limits how many checks one request may run, and a longer
    // per-field version was rejected for valid entries. The site validates the remaining fields
    // when it reads entries (cleanFilm in app.js).
    function validFilm(f) {
      return f is map
        && f.keys().hasOnly(['id', 'title', 'year', 'poster', 'directors', 'genres', 'keywords',
                             'countries', 'lang', 'cast', 'overview', 'runtime'])
        && f.id is string && f.id.size() > 0 && f.id.size() <= 40
        && f.title is string && f.title.size() > 0 && f.title.size() <= 200;
    }

    // Each student (anonymous sign-in) can only write their own document, in a validated shape.
    // Everyone can read, because the whole class sees the matches.
    match /participants/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'films', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.films is list
        && request.resource.data.films.size() == 4
        && validFilm(request.resource.data.films[0])
        && validFilm(request.resource.data.films[1])
        && validFilm(request.resource.data.films[2])
        && validFilm(request.resource.data.films[3]);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
