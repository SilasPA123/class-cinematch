rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada aluno (login anônimo) só escreve o próprio documento, com formato validado.
    // Todos podem ler, porque a turma inteira vê os matches.
    match /participants/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'films', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.films is list
        && request.resource.data.films.size() == 4;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
